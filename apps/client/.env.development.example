# Если API на другом порту (например, 3000 занят и сервер на 3001):
# VITE_API_TARGET=http://127.0.0.1:3001

# Альтернатива: только порт
# VITE_API_PORT=3001

# VPN / «ломается» dev-сервер: зафиксировать HMR на loopback (часто помогает)
# VITE_HMR_HOST=127.0.0.1
# VITE_HMR_CLIENT_PORT=5173
# VITE_HMR_PROTOCOL=ws
