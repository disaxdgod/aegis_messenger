# Если API на другом порту (например, 3000 занят и сервер на 3001):
# VITE_API_TARGET=http://127.0.0.1:3001

# Альтернатива: только порт
# VITE_API_PORT=3001

# --- Режим бэкенда ---
# 0 (по умолчанию) — только фронт, auth в localStorage, `pnpm dev` из корня.
# 1 — запросы на /api и Socket.IO; нужны Postgres и `pnpm dev:full` или `pnpm dev:backend`.
# VITE_BACKEND_ENABLED=0

# Демо-аккаунт в локальном режиме (без сервера):
# логин d_biryukov / пароль Aegis2026!

# По умолчанию dev — HTTP (http://localhost:5173). Для Web Crypto этого достаточно в Chromium.
#
# Встроенный HTTPS (самоподписанный basic-ssl) — ТОЛЬКО если явно:
#   VITE_USE_HTTPS=1
# Браузер покажет красное предупреждение — это нормально для такого сертификата.
#
# «Зелёный» замок локально: установите mkcert, выпустите cert+key и укажите:
# VITE_DEV_HTTPS_KEY=C:\path\to\localhost-key.pem
# VITE_DEV_HTTPS_CERT=C:\path\to\localhost.pem

# VPN / «ломается» dev-сервер
# VITE_HMR_HOST=127.0.0.1
# VITE_HMR_CLIENT_PORT=5173
# При HTTPS (mkcert или VITE_USE_HTTPS=1) HMR обычно WSS; при необходимости:
# VITE_HMR_PROTOCOL=wss
