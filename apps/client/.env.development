# Локальный режим без PostgreSQL и Node-сервера (по умолчанию).
# Регистрация/вход — в localStorage браузера.
VITE_BACKEND_ENABLED=0

# Чтобы снова включить API + Socket.IO:
# 1) VITE_BACKEND_ENABLED=1
# 2) pnpm compose:postgres && pnpm dev:full
#    (или pnpm dev:backend — postgres + client + server)
