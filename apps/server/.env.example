# PostgreSQL (см. docker-compose.yml в корне репозитория).
# Без кавычек вокруг значения — на Windows это избегает сюрпризов с парсингом `.env`.
# Если P1000: возможно другой Postgres на том же порту или старый пароль в томе — см. docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/aegis?schema=public

# Порт HTTP + Socket.IO (если 3000 занят — задайте другой и см. apps/client/.env.development.example)
# PORT=3000

# Origin фронтенда для CORS и Socket.IO (dev обычно http://localhost:5173)
# CLIENT_ORIGIN=http://localhost:5173
# Опционально: слушать API по HTTPS напрямую (без прокси Vite). Укажите оба пути к PEM.
# HTTPS_KEY_PATH=C:\path\to\privkey.pem
# HTTPS_CERT_PATH=C:\path\to\fullchain.pem

# JWT (обязательно в production)
# JWT_SECRET=long-random-string
# В продакшене безопаснее короткий access JWT (например 15m); обновление — POST /api/auth/refresh
# JWT_EXPIRES_IN=15m

# Refresh-сессии (opaque токены, в БД хранится только хеш SHA-256)
# REFRESH_TOKEN_DAYS=30

# Обратный прокси (Express trust proxy хопов; за nginx почти всегда 1)
# TRUST_PROXY=1

# Лимиты (опционально)
# RATE_LIMIT_GLOBAL_MAX=400
# RATE_LIMIT_AUTH_PER_MIN=30

# Уровень логов сервера
# LOG_LEVEL=info

# Каталог для uploads (avatars, msg-staging — создаются автоматически)
# UPLOAD_DIR=D:\aegis\apps\server\uploads