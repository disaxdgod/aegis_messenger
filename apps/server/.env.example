# URL базы данных. По умолчанию в prisma.config используется SQLite: file:./dev.db (относительно каталога prisma/).
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/aegis"

# Порт HTTP + Socket.IO (если 3000 занят — задайте другой и см. apps/client/.env.development.example)
# PORT=3000

# Origin фронтенда для CORS и Socket.IO
# CLIENT_ORIGIN=http://localhost:5173
