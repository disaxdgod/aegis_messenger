{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true, // ОБЯЗАТЕЛЬНО для references
    "declaration": true, // Генерация файлов типов
    "declarationMap": true, // Для удобного перехода к коду (Ctrl+Click)
    "noEmit": false, // Выключаем запрет на генерацию файлов
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src"]
}
